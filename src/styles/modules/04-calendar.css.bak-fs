  /* ---------- 日历 ---------- */
  .cal-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .cal{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px 18px;position:relative}
  .cal .date{font-family:var(--mono);font-size:11.5px;color:var(--accent);font-weight:700;letter-spacing:.06em}
  .cal .stage{display:inline-block;margin-top:6px;font-size:11px;padding:2px 8px;border-radius:99px;background:var(--accent-soft);color:var(--accent)}
  .cal h4{font-size:15px;margin:8px 0 4px;color:var(--ink)}
  .cal p{font-size:12.5px;color:var(--muted)}
  .cal .src{margin-top:10px;font-family:var(--mono);font-size:10.5px;color:var(--muted);border-top:1px dashed var(--line);padding-top:8px}

