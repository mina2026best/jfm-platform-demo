  /* ---------- 首屏 ---------- */
  .hero{padding:64px 0 46px;border-bottom:1px solid var(--line);background:
    radial-gradient(1200px 400px at 85% -10%, #E9EEF5 0%, transparent 60%),var(--bg)}
  .hero h1{font-family:var(--serif);font-size:38px;line-height:1.28;color:var(--navy);max-width:22em}
  .hero h1 b{color:var(--accent)}
  .hero .sub{margin:14px 0 30px;color:var(--ink2);max-width:44em;font-size:16px}
  .hero .sub b{color:var(--ink)}
  /* 三入口 */
  .entries{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .entry{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:24px 22px;text-decoration:none;display:block;transition:box-shadow .15s,transform .15s,border-color .15s}
  .entry:hover{box-shadow:0 6px 22px rgba(36,52,77,.10);border-color:var(--line2);transform:translateY(-2px)}
  .entry:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .entry .no{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.14em}
  .entry h3{font-family:var(--serif);font-size:20px;color:var(--navy);margin:8px 0 6px}
  .entry p{font-size:13.5px;color:var(--muted)}
  .entry .go{display:inline-block;margin-top:14px;font-size:13px;color:var(--accent);font-weight:600}
  .entry:hover .go{text-decoration:underline}

  /* ---------- v0.52 品牌（家长屿） ---------- */
  .hero-kicker{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:var(--accent);background:var(--accent-soft);border-radius:999px;padding:5px 14px;margin-bottom:14px}
  .hero-kicker .hk-mark{position:relative;width:11px;height:11px;flex:0 0 auto}
  .hero-kicker .hk-mark::before{content:"";position:absolute;left:1px;top:0;width:9px;height:9px;border-radius:52% 52% 44% 44%;background:linear-gradient(155deg,var(--accent),var(--blue))}
  .hero-kicker .hk-mark::after{content:"";position:absolute;left:-2px;bottom:-2px;width:15px;height:4px;border-radius:50%;background:var(--accent);opacity:.22}
  .brand-card{border-color:var(--accent)!important;background:linear-gradient(180deg,var(--accent-soft),var(--paper))!important}
  .brand-claim{display:inline-block;margin-top:10px;font-family:var(--serif);font-size:14.5px;color:var(--accent);font-weight:700}
  .brand-mean{color:var(--ink2)}
  @media (max-width:720px){ .hero-kicker{font-size:10.5px;letter-spacing:.08em;padding:4px 11px} }
