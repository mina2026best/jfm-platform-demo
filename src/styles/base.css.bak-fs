
  :root{
    --bg:#F6F7F9; --paper:#FFFFFF; --ink:#17212E; --ink2:#3C4858; --muted:#6B7683;
    --navy:#24344D; --navy2:#3E5375; --blue:#5D77A3; --line:#E3E7EC; --line2:#C9D1D9;
    --accent:#0E7C66; --accent-soft:#E8F2EF; --warn:#B45309; --warn-soft:#FCF3E3;
    --serif:"Songti SC","Noto Serif SC",serif;
    --sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  header[id],section[id]{scroll-margin-top:76px}
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  }
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.7}
  a{color:var(--navy)}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}


  /* ---------- v0.11：公告条 / 导航高亮 ---------- */
  .ann-bar{background:var(--navy);color:#DCE4EE;font-size:12.5px}
  .ann-bar .wrap{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px;padding:8px 24px}
  .ann-bar .ab-tag{font-family:var(--mono);font-size:10px;border:1px solid rgba(255,255,255,.4);border-radius:4px;padding:1px 6px;color:#fff;flex:none;letter-spacing:.08em}
  .ann-bar .ab-text{min-width:0}
  .ann-bar a{color:#9EC7FF;text-decoration:none;white-space:nowrap}
  .ann-bar a:hover{text-decoration:underline}
  .ann-bar .ab-x{margin-left:auto;background:none;border:none;color:#DCE4EE;font-size:16px;cursor:pointer;line-height:1;padding:2px 6px}
  .ann-bar .ab-x:hover{color:#fff}
  .top nav a.on{background:var(--accent-soft);color:var(--accent)}
