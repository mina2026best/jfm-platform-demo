  /* ---------- 流程 ---------- */
  .flow{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;counter-reset:f}
  .fstep{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:14px;position:relative;counter-increment:f}
  .fstep::before{content:counter(f,decimal-leading-zero);font-family:var(--mono);font-size:11px;color:var(--accent);font-weight:700}
  .fstep h5{font-size:13.5px;margin:6px 0 4px;color:var(--ink)}
  .fstep p{font-size:11.5px;color:var(--muted)}
  .fstep .sla{font-family:var(--mono);font-size:10.5px;color:var(--accent);margin-top:8px;display:block}

