  /* ---------- v0.30：搜索页 / FAQ 页 / 热点榜（门户对齐） ---------- */
  .sp-hero{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:22px 24px;margin:20px 0 18px}
  .sp-box{display:flex;gap:10px;flex-wrap:wrap}
  .sp-box input{flex:1;min-width:220px;font-size:15px;padding:12px 16px;border:1.5px solid var(--line2);border-radius:99px;font-family:var(--sans);background:var(--bg);color:var(--ink)}
  .sp-box input:focus{outline:2px solid var(--accent);outline-offset:1px}
  .sp-box button{border-radius:99px;padding:12px 26px}
  .sp-hot{margin-top:12px;font-size:13px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .sp-hot a{color:var(--ink2);text-decoration:none;border:1px solid var(--line);border-radius:99px;padding:3px 12px}
  .sp-hot a:hover{color:var(--accent);border-color:var(--accent)}
  .sp-sec{margin-top:26px}
  .sp-sec h3{font-family:var(--serif);font-size:17px;color:var(--navy);margin-bottom:10px}
  .sp-list{display:grid;gap:8px}
  .sp-row{display:flex;gap:10px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:12px 14px;text-decoration:none}
  .sp-row:hover{border-color:var(--accent)}
  .sp-row .s-badge{flex:none;margin-top:1px}
  .sp-row .t{font-size:14px;color:var(--ink);line-height:1.5}
  .sp-row .t small{display:block;color:var(--muted);font-size:12px;margin-top:3px}
  .sp-empty{background:var(--paper);border:1px dashed var(--line2);border-radius:10px;padding:26px;text-align:center;color:var(--muted);font-size:14px}
  .sp-go a.sp-back{font-size:13px;color:var(--accent);text-decoration:none}
  /* FAQ */
  .faq-cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
  .faq-grid{display:grid;gap:10px;max-width:860px}
  .faq-item{background:var(--paper);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .faq-item summary{cursor:pointer;padding:14px 16px;font-size:14.5px;color:var(--ink);font-weight:600;list-style:none;display:flex;gap:10px;align-items:baseline}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary .cat{flex:none;font-family:var(--mono);font-size:10.5px;color:var(--accent);background:var(--accent-soft);border-radius:4px;padding:2px 8px}
  .faq-item[open] summary{border-bottom:1px solid var(--line)}
  .faq-item .a{padding:12px 16px 14px;font-size:13.5px;color:var(--ink2);line-height:1.8}
  .faq-item .a a{color:var(--accent)}
  /* 热点榜 */
  .hot-rank{display:grid;gap:8px}
  .hot-rank a{display:flex;gap:12px;align-items:baseline;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:11px 14px;text-decoration:none}
  .hot-rank a:hover{border-color:var(--accent)}
  .hot-rank .no{flex:none;font-family:var(--mono);font-size:13px;color:var(--accent);font-weight:700;width:20px}
  .hot-rank .no.hot-no3{color:#D9534F}
  .hot-rank .t{font-size:13.5px;color:var(--ink)}
  .hot-rank .meta{margin-left:auto;flex:none;font-size:11.5px;color:var(--muted)}
  .home-grid2{display:grid;grid-template-columns:1.2fr 1fr;gap:26px;align-items:start;margin-top:16px}
  @media (max-width:960px){ .home-grid2{grid-template-columns:1fr} }
