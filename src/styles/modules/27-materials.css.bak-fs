  /* ---------- v0.25：入学材料清单生成器 ---------- */
  .mat-tool{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px 18px;margin-top:12px}
  .mat-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .mat-row label{font-size:13px;color:var(--ink2);display:flex;gap:6px;align-items:center}
  .mat-row select{font-size:13px;padding:7px 10px;border:1px solid var(--line2);border-radius:6px;font-family:var(--sans);background:var(--paper);color:var(--ink)}
  .mat-out{margin-top:12px;font-size:13.5px;color:var(--ink2);line-height:1.8}
  .mat-h{font-family:var(--serif);font-size:15px;color:var(--navy);margin:12px 0 6px}
  .mat-list{list-style:none;display:grid;gap:6px}
  .mat-list li{display:flex;gap:8px;font-size:13.5px;color:var(--ink2);align-items:flex-start}
  .ck2{flex:none;width:12px;height:12px;border:1.5px solid var(--accent);border-radius:2px;transform:translateY(3px)}
  .mat-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;align-items:center}
  .mat-note{font-size:12px;color:var(--muted)}
