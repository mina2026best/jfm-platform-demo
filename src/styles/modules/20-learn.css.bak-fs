  /* ---------- v0.12：家长学堂 ---------- */
  .learn-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}
  .learn-col{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:18px 20px}
  .learn-h{font-family:var(--serif);font-size:17px;color:var(--navy);margin-bottom:12px;display:flex;align-items:baseline;gap:8px}
  .learn-sub{font-family:var(--mono);font-size:10.5px;color:var(--muted);font-weight:400;letter-spacing:.06em}
  .lq{border-bottom:1px dashed var(--line);padding:2px 0}
  .lq:last-child{border-bottom:none}
  .lq summary{cursor:pointer;font-size:13.5px;color:var(--ink);padding:9px 2px;list-style:none;display:flex;gap:8px;align-items:baseline}
  .lq summary::-webkit-details-marker{display:none}
  .lq summary::after{content:'＋';margin-left:auto;color:var(--muted);font-size:13px;flex:none}
  .lq[open] summary::after{content:'－'}
  .lq[open] summary{color:var(--accent)}
  .lq-tag{flex:none;font-size:10.5px;padding:1px 8px;border-radius:99px;background:var(--accent-soft);color:var(--accent);font-weight:600}
  .lq-tag.gold{background:var(--warn-soft);color:var(--warn)}
  .lq-a{font-size:12.5px;color:var(--ink2);line-height:1.85;padding:2px 2px 10px;border-left:2px solid var(--accent-soft);padding-left:10px;margin-left:2px}
  .lq-by{display:block;margin-top:6px;font-family:var(--mono);font-size:10.5px;color:var(--muted)}
  @media (max-width:960px){
    .learn-grid{grid-template-columns:1fr}
  }
